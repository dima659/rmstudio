# Токен бота от @BotFather
BOT_TOKEN=
# Ваш числовой Telegram ID (узнать у @userinfobot): сюда приходят заявки и заказы
ADMIN_CHAT_ID=
# Ссылки для профиля (необязательно)
CHANNEL_URL=https://t.me/your_channel
REVIEWS_URL=
SUPPORT_URL=https://t.me/your_manager
# Только если у сервиса свой домен (на Render берётся автоматически)
# APP_URL=https://example.com
# Для постоянного хранения (диск Render): DATA_DIR=/var/data
